# Cloud-minimal arm64 kernel fragment. Overlaid on top of
# `make ARCH=arm64 defconfig` (which already enables EFI_STUB, PL011
# serial, virtio-blk/net, ACPI, devtmpfs, etc.) and stripped of every
# vendor SoC driver and peripheral that is irrelevant to a QEMU virt
# guest. The resulting kernel weighs in around 5–10 MiB versus the
# ~40 MiB defconfig.

# ---- Keep ARCH_VIRT + drop every vendor SoC ----
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_ARCH_VIRT=y

# ---- Builtin everything; no modules at all ----
# CONFIG_MODULES is not set

# ---- Drop wireless / Bluetooth / NFC / RF ----
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
# CONFIG_NET_VENDOR_3COM is not set

# ---- Drop sound, MMC, MTD, USB host stack ----
# CONFIG_SOUND is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_INPUT is not set

# ---- Drop graphics — we boot to a serial console only ----
# Framebuffer + virtual terminal subsystem. Enabled so the kernel can
# draw to a VirtIO-GPU scanout (Apple Virtualization.framework attaches
# one when running with a graphical window), giving the VGA tab in vzd
# something to render. Costs ~500 KB but pays for itself in debug:
# without these, `console=tty0` is a no-op and you fly blind on
# headless-incompatible hypervisors.
#
#   DRM_VIRTIO_GPU   — the post-DRM-init path for Apple VZ's scanout
#   DRM_SIMPLEDRM    — the early-boot EFI handoff framebuffer (used
#                      before the virtio_gpu driver takes over)
#   FRAMEBUFFER_CONSOLE — wires the fb into VT so kernel printk lands
#                      on /dev/tty0
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# VIRTIO_INPUT — the matching input side of the GUI story.
# DRM_VIRTIO_GPU gives the kernel a scanout to draw onto;
# VIRTIO_INPUT gives it the keyboard/pointer events vfkit's
# --gui mode injects via the virtio-input bus. Without it the
# vfkit window renders the kernel printk + login prompt but
# every keystroke goes into the void. Linux fans out kbd
# events through INPUT_EVDEV (already enabled), then the VT
# layer consumes them as /dev/tty0 stdin — letting the
# menu-then-reboot menu accept "1<Enter>" from the GUI
# window the same way it would from a real PS/2 keyboard.
CONFIG_VIRTIO_INPUT=y

# USB-HID keyboard support. vfkit's --gui mode (and its
# `--device virtio-input,keyboard` flag) actually exposes the
# host keyboard via Apple's VZUSBKeyboardConfiguration — i.e.
# a USB-HID device on an xHCI controller, NOT a native
# virtio-input device. Without USB_HID + HID + xHCI the guest
# kernel's enumeration of /proc/bus/input/devices only shows
# the ACPI "Power Button"; the keyboard is invisible and the
# menu blocks forever on input. Adds ~600 KB to the kernel
# image; pays for itself the first time you want to pick a
# target without ssh'ing into the running VM.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- Drop legacy storage; virtio-blk is the only block backend ----
# CONFIG_ATA is not set
# CONFIG_SATA_AHCI is not set
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_CORE is not set
# CONFIG_MD is not set
# CONFIG_BCACHE is not set

# ---- Drop exotic filesystems; ext4 + tmpfs cover the cloud case ----
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_FUSE_FS is not set

# ---- Keep what we actually need ----
CONFIG_EXT4_FS=y
# GPT + MS-DOS partition table parsing — without these the kernel
# sees a plain /dev/vda but can't enumerate /dev/vda1 etc., which
# breaks cloud-boot's disk mode for any rootfs that lives on a
# partition (i.e. every distro cloud image). Same set as
# disk-arm64.config and the cloud-amd64.config defaults.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# virtio-rng + hwrng plumbing: without these the kernel's crng never
# seeds in time on a minimal guest (no EFI_RNG_PROTOCOL, no e1000 IRQ
# jitter, no userspace…) and getrandom() blocks. cloud-boot-init's DHCP
# client then times out trying to generate a transaction ID.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_RNG=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_PCI=y
CONFIG_ACPI=y

# ---- Drop the physical-NIC vendor zoo ----
# CONFIG_ETHERNET is the master switch for every wired NIC vendor (Intel
# e1000/e1000e/igb, Marvell sky2, Cavium thunder, Hisilicon hns, …). A
# cloud guest only ever speaks virtio-net, which is independent of this
# tree (controlled by CONFIG_VIRTIO_NET below in "what we actually need").
CONFIG_ETHERNET=n

# ---- Drop pile of misc subsystems we never reach ----
# CONFIG_HW_RANDOM kept on (virtio-rng entry above) — needed to seed the
# kernel CRNG fast enough for cloud-boot-init's DHCP client to get a
# transaction ID without timing out.
# CONFIG_TCG_TPM is not set
# CONFIG_IIO is not set
# CONFIG_PWM is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_GENERIC_PHY is not set
# CONFIG_W1 is not set
# CONFIG_POWER_RESET is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_MFD_CORE is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_DMADEVICES is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_INFINIBAND is not set
# CONFIG_NVMEM is not set
# CONFIG_RESET_CONTROLLER is not set

# ---- Smaller, simpler scheduler / kernel ----
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set

# ---- Phase 2 trim: more aggressive, still cloud-safe ----

# Optimise for size, not speed (saves ~10–15 %).
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# We are a guest, not a hypervisor host.
# CONFIG_KVM is not set
# CONFIG_VHOST_MENU is not set

# Skip eBPF: not used by our test workload, surface is massive.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_BPF_PRELOAD is not set

# Tracing / instrumentation we have no use for at this scale.
# CONFIG_KPROBES is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_TRACEPOINTS is not set

# POSIX AIO, fanotify, userfaultfd: container/desktop features.
# CONFIG_AIO is not set
# CONFIG_FANOTIFY is not set
# CONFIG_USERFAULTFD is not set

# Memory hotplug, kdump: not needed in a single-shot VM.
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_CRASH_DUMP is not set

# Drop the whole LSM stack — no apparmor / selinux / yama enforcement.
# CONFIG_SECURITY is not set
# CONFIG_HARDENED_USERCOPY is not set

# EFI zboot: ship a self-decompressing PE32+ stub. Drops the on-disk
# Image size by ~3× on aarch64 because the payload is gzipped inside
# the EFISTUB wrapper and decompresses to RAM at boot.
CONFIG_EFI_ZBOOT=y

# Bake `nr_cpus=1` into the kernel image.
#
# This config builds the cloud-boot *stub* kernel — the one embedded in
# the UKI whose only job is to fetch a plan over OCI and kexec into the
# real target kernel. It runs strictly serially (no parallel HTTP, no
# parallel kexec) so a second CPU buys nothing.
#
# arm64's kexec requires num_online_cpus() == 1 before the jump
# (BUG_ON in arch/arm64/kernel/machine_kexec.c). The natural offlining
# path PSCI_CPU_OFF doesn't actually halt the vCPU under HVF (Apple
# Silicon hypervisor), so cpu_die()'s final BUG fires. By telling the
# kernel up front to only bring up CPU 0 we sidestep the cpu_die path
# entirely — same pattern as petitboot and most initramfs stubs.
#
# CMDLINE_EXTEND appends the built-in fragment to whatever the EFI stub
# read from the UKI's .cmdline section, so the runtime cloudboot.*
# directives (cloudboot.plan=..., cloudboot.target=..., etc.) still get
# through. arm64's Kconfig doesn't expose CMDLINE_EXTEND upstream yet;
# we add it via patches/arm64-cmdline-extend.patch applied at build
# time. Drop the patch when it lands in upstream.
#
# NOTE: do NOT use this config for the TARGET kernel — it would lose
# multi-CPU. Use a normal distro kernel (or a separate fragment without
# this block) for production targets.
CONFIG_CMDLINE="nr_cpus=1"
CONFIG_CMDLINE_EXTEND=y
