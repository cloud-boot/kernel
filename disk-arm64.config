# Disk-boot extras for arm64, layered on top of tiny-arm64.config.
# Purpose: give the tiny kernel just enough surface to read a real
# distro's /boot from a virtio-blk volume and kexec into the distro's
# own kernel + initramfs.
#
# Not included on purpose:
#   * NVMe/AHCI/SATA — cloud guests see virtio-blk only
#   * f2fs / ZFS — neither shows up on mainstream cloud images
#   * dm-crypt / LVM — cloud images are usually unencrypted; reserved
#     for a follow-up "disk-luks" fragment
#   * KEXEC_SIG / signature chain — reserved for a follow-up
#     "disk-secureboot" fragment that also brings in CRYPTO_SHA256 etc.

# ---- GPT + MS-DOS partition tables. EFI_PARTITION covers every cloud
#      image; MSDOS keeps legacy / locally-built rootfs images working. ----
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ---- Filesystems we mount to read /boot/{vmlinuz,Image}-* + initrd. ----
#
# ext4: Debian / Ubuntu / Fedora /boot / Alpine
# xfs:  AlmaLinux / RHEL family (rootfs AND /boot)
# btrfs: openSUSE MicroOS / Leap Micro (root subvol carries /boot), and
#        Fedora's actual rootfs (we mount /boot separately, but having
#        btrfs available lets us also mount the rootfs if the user
#        explicitly points the plan at it via `disk { device = "...root" }`)
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
# vfat — needed for the menu-then-reboot sink to mount the FAT EFI
# System Partition read-write and drop the chosen target's vmlinuz
# + initrd into \EFI\Linux\ where the firmware's boot manager can
# load them on the next round. See memory:uki-menu-then-reboot.
# NLS_CODEPAGE_437 + NLS_ISO8859_1 = the default codepage / iocharset
# the FAT filesystem reaches for; without them mount(8) fails with
# EINVAL.
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_ASCII=y
# efivarfs — userspace surface for reading/writing UEFI NVRAM
# variables. The reboot sink writes Boot0001 (LoadOption pointing
# at the chosen UKI on the ESP) and updates BootOrder via files
# under /sys/firmware/efi/efivars/.
CONFIG_EFIVAR_FS=y
CONFIG_EFI_VARS=y
# virtio-console — Apple Virtualization.framework exposes the
# guest serial as virtio-console (Linux device /dev/hvc0), not
# PL011. Without this, a vfkit-launched VM running our kernel
# has no kernel console at all and produces zero serial output
# — exactly the silent-black-screen failure observed on the
# first vfkit:arm64:menu attempt. QEMU/virt continues to work
# via SERIAL_AMBA_PL011 (already enabled in tiny-arm64.config),
# so booting via `console=hvc0` under vfkit and `console=ttyAMA0`
# under QEMU now both produce visible output.
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
# btrfs pulls in zlib/zstd as transitive deps; tinyconfig leaves them
# disabled, so spell out what btrfs strictly needs to mount + read.
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_RAID6_PQ=y
CONFIG_XOR_BLOCKS=y
CONFIG_LIBCRC32C=y
CONFIG_CRC32=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y

# ---- kexec: hand control to the distro kernel. kexec_file_load (the
#      "_FILE" variant) lets us pass kernel + initrd as file descriptors
#      and lets the kernel itself parse the image, which is what we want
#      to chain into a Image / vmlinuz. ----
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
