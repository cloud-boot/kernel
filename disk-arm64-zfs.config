# Additional kernel config layered on top of disk-arm64.config when
# building the disk-zfs variant (Dockerfile.arm64-disk-zfs).
#
# The base disk-arm64.config inherits tinyconfig's
# `# CONFIG_MODULES is not set` — everything's compiled into vmlinuz
# directly, no /lib/modules at runtime. That's fine for kexec-only
# scenarios (the chained kernel brings its own modules) but
# incompatible with OpenZFS, which we build as a loadable module
# AFTER the kernel is built and modprobe at boot.
#
# Why not build OpenZFS in-tree (--enable-linux-builtin): legally it
# works for our internal builds (CDDL-vs-GPL is a redistribution
# concern, not a build-time one for derivative works of our own),
# but mechanically it's more fragile — OpenZFS's tree expects to
# live in a separate makefile chain, and in-tree builds break with
# kernel updates more often than modular builds.

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# /lib/modules/ resolution helper used by depmod + modprobe in the
# initramfs's busybox.
CONFIG_MODULE_SIG=n
# OpenZFS-specific runtime dependencies the in-tree disk fragment
# already pulls in transitively (CRYPTO + ZLIB) — re-listed
# explicitly so a future trim of disk-arm64.config can't silently
# break the ZFS variant.
CONFIG_CRYPTO_DEFLATE=y
CONFIG_BLK_DEV_LOOP=y
