# Disk-boot extras for amd64, layered on top of tiny-amd64.config.
# Mirrors disk-arm64.config — same intent (read a distro rootfs from
# virtio-blk and kexec into the distro's own kernel + initramfs).
#
# Not included on purpose:
#   * NVMe/AHCI/SATA — cloud guests see virtio-blk only
#   * btrfs / xfs / f2fs — ext4 covers most cloud images
#   * dm-crypt / LVM — reserved for "disk-luks" fragment
#   * KEXEC_SIG / signature chain — reserved for "disk-secureboot"
#     fragment that also brings in the CRYPTO stack

# ---- Partition tables ----
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ---- ext4 ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# ---- kexec ----
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
