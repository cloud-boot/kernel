# Minimum-viable cloud guest x86_64 kernel, layered on `tinyconfig`.
# Goal: just enough to boot via EFISTUB on QEMU q35 (or
# Firecracker / Cloud Hypervisor), mount a gzipped initramfs, run
# /init, power off cleanly.
#
# Mirrors tiny-arm64.config — same intent, different hardware backbone:
#   * APIC + IO-APIC instead of GIC
#   * NS16550 UART at 0x3F8 (ttyS0) instead of PL011
#   * ACPI is mandatory (firmware exposes everything via ACPI)
#   * x86 PCI host bridge instead of OF/DT
#
# Networking: minimal IPv4 stack over virtio-net (same set as the
# arm64 sibling) so the guest can do DNS / outbound HTTP.
#
# Anything that breaks an actual cloud boot can be added here.

# ---- Architecture bits the x86_64 build cannot function without ----
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y                      # cloud VMs are commonly multi-vCPU
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_HAVE_KERNEL_GZIP=y
CONFIG_KERNEL_GZIP=y

# ---- ACPI: firmware exposes hardware via ACPI tables — without this
#      the kernel cannot find devices and goes silent. ----
CONFIG_ACPI=y

# ---- EFI / EFISTUB boot path ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_GENERIC_STUB_INITRD_CMDLINE_LOADER=y

# ---- Console: QEMU virt PCs and most cloud VMs route serial to
#      ttyS0 (NS16550 at I/O port 0x3F8). ----
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# ---- Initramfs ingestion ----
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y

# ---- VirtIO so future cloud workloads have a path to the host ----
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y

# ---- Networking: minimal IPv4 + virtio-net so the guest can resolve
#      DNS and reach external HTTP endpoints. AF_UNIX is here too
#      because most userspace (libc resolver, busybox) needs it. ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y               # AF_PACKET — DHCP clients use raw sockets
CONFIG_UNIX=y                 # AF_UNIX — libc / busybox / nss
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# Let the kernel itself bring the link up + grab a DHCP lease, so /init
# can curl without dragging a userspace DHCP client into the initramfs.
# Pass `ip=dhcp` on the kernel command line to activate.
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# ---- Tiny stat / proc surface ----
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ---- Optimize for size, not speed ----
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
