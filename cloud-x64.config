# Cloud-minimal x86_64 kernel fragment. Overlaid on top of
# `make ARCH=x86_64 defconfig`. Same intent as cloud-aa64.config — turn
# off every device class a virt machine cannot reach. Boots in QEMU's
# q35 / pc machine on top of virtio-blk, virtio-net, NS16550 serial.

# ---- Drop legacy x86 platforms and the PC vendor zoo ----
# CONFIG_X86_PLATFORM_DRIVERS_AMD is not set
# CONFIG_X86_PLATFORM_DRIVERS_DELL is not set
# CONFIG_X86_PLATFORM_DRIVERS_HP is not set
# CONFIG_X86_PLATFORM_DRIVERS_INTEL is not set

# ---- Audio: a cloud VM has no soundcards ----
CONFIG_SOUND=n

# ---- Graphics: cloud is serial / paravirtual, no real GPU ----
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_LOGO=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n

# ---- Input: no physical peripherals on a server VM ----
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INPUT_MISC=n

# ---- USB: virtio replaces every USB peripheral we care about ----
CONFIG_USB_SUPPORT=n
CONFIG_HID=n

# ---- Wireless / Bluetooth / cellular: zero relevance in a VM ----
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_BT=n
CONFIG_WIRELESS=n
CONFIG_RFKILL=n

# ---- Storage: cloud VMs use virtio-blk and virtio-scsi only ----
CONFIG_MD=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_MTD=n
CONFIG_ATA=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_NVME_CORE=n

# ---- Bus / peripheral controllers a virt machine never exposes ----
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_PARPORT=n
CONFIG_ISDN=n
CONFIG_FIREWIRE=n
CONFIG_PCMCIA=n

# ---- Sensors / thermal / power: VMs don't have batteries either ----
CONFIG_HWMON=n
CONFIG_THERMAL=n
CONFIG_POWER_SUPPLY=n
CONFIG_RC_CORE=n
CONFIG_WATCHDOG=n

# ---- Hibernation / cpu hotplug / kexec: cloud VMs are simpler ----
CONFIG_HIBERNATION=n
CONFIG_PM_AUTOSLEEP=n
CONFIG_PM_DEBUG=n
CONFIG_KEXEC_FILE=n
CONFIG_KEXEC_SIG=n

# ---- Filesystems: keep ext4, vfat, tmpfs (already enabled in defconfig) ----
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_XFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_OCFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_CEPH_FS=n
CONFIG_CIFS=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_9P_FS=n
CONFIG_AFS_FS=n
CONFIG_NTFS3_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_HFS_FS=n
CONFIG_BFS_FS=n
CONFIG_UDF_FS=n
CONFIG_ROMFS_FS=n
CONFIG_SQUASHFS=n
CONFIG_PSTORE=n
CONFIG_EFI_PARTITION=y

# ---- Network: drop bridges, VLANs, exotic protocols ----
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_NET_SCHED=n
CONFIG_NET_CLS=n
CONFIG_BPFILTER=n
CONFIG_BONDING=n
CONFIG_NET_TEAM=n
CONFIG_TIPC=n
CONFIG_ATM=n
CONFIG_DECNET=n
CONFIG_LLC2=n
CONFIG_RDS=n
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_L2TP=n
CONFIG_CAIF=n

# ---- Tracing / profiling: huge kernel feature, off by default for size ----
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_DEBUG_KERNEL=n
CONFIG_LOCKDEP=n
CONFIG_KGDB=n

# ---- Crypto offload accelerators ----
CONFIG_CRYPTO_HW=n

# ---- Things to explicitly keep on ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_GENERIC_STUB_INITRD_CMDLINE_LOADER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_RNG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_BINFMT_ELF=y
CONFIG_ACPI=y
CONFIG_PCI=y

# ---- Phase 2 trim: more aggressive, still cloud-safe ----

CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# Guest, not host.
# CONFIG_KVM is not set
# CONFIG_VHOST_MENU is not set

# x86 has hypervisor-specific guest support paths. Keep generic KVM
# guest detection on (CONFIG_KVM_GUEST is part of defconfig and is
# cheap), but drop the legacy ones we won't run under.
# CONFIG_HYPERV is not set
# CONFIG_XEN is not set
# CONFIG_AMD_MEM_ENCRYPT is not set

# Skip eBPF.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_BPF_PRELOAD is not set

# Tracing / instrumentation.
# CONFIG_KPROBES is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_TRACEPOINTS is not set

# Container/desktop features we don't need.
# CONFIG_AIO is not set
# CONFIG_FANOTIFY is not set
# CONFIG_USERFAULTFD is not set

# Memory hotplug, kdump.
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_CRASH_DUMP is not set

# Drop the whole LSM stack.
# CONFIG_SECURITY is not set
# CONFIG_HARDENED_USERCOPY is not set
