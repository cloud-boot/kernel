# Builds a minimal aarch64 Linux kernel as a PE32+ EFISTUB Image, ready
# to be embedded as the `.linux` section of a UKI. Designed to run on an
# aarch64 host (Apple Silicon, Graviton, etc.) so the build is native —
# no qemu-user emulation, no cross-toolchain dance.

FROM debian:bookworm-slim AS build

ARG LINUX_VERSION=7.0.8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libelf-dev \
    bc \
    flex \
    bison \
    cpio \
    wget \
    xz-utils \
    bsdmainutils \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Pull the stable tarball directly from kernel.org. Avoids cloning the
# full git history (~5 GiB) when we only want one revision.
RUN wget -q "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${LINUX_VERSION}.tar.xz" \
 && tar -xf "linux-${LINUX_VERSION}.tar.xz" \
 && rm "linux-${LINUX_VERSION}.tar.xz"

WORKDIR /build/linux-${LINUX_VERSION}

# Cloud-minimal config: start from `defconfig` (which already enables
# EFI_STUB + PL011 serial + virtio-blk/net + ACPI), then overlay the
# fragment that strips every vendor SoC, exotic filesystem, USB,
# wireless, MMC, sound, DRM and legacy storage stack — none of which a
# QEMU-virt cloud guest can reach. `make olddefconfig` resolves any
# new dependencies the overlay introduces.
COPY cloud-arm64.config /build/cloud-arm64.config

# Expose CMDLINE_EXTEND as a Kconfig choice on arm64 (mainline only ships
# FROM_BOOTLOADER + FORCE — see patches/arm64-cmdline-extend.patch header
# for the rationale and the upstream link). Without this patch the
# CONFIG_CMDLINE_EXTEND=y line in cloud-arm64.config would be silently
# dropped by `olddefconfig`.
COPY patches/arm64-cmdline-extend.patch /build/arm64-cmdline-extend.patch
RUN patch -p1 < /build/arm64-cmdline-extend.patch

RUN make ARCH=arm64 defconfig \
 && cat /build/cloud-arm64.config >> .config \
 && make ARCH=arm64 olddefconfig

# Native build. With CONFIG_EFI_ZBOOT=y, the `vmlinuz.efi` target
# produces a self-decompressing PE32+ EFISTUB: a small stub that
# wraps the kernel image gzipped inside and decompresses it into RAM
# at boot. ~5× smaller on disk than the bare `Image` (which has zero
# compression) and still chain-loadable by our stub's LoadImage.
RUN make ARCH=arm64 -j"$(nproc)" vmlinuz.efi

# We export it under the name `Image` so downstream consumers do not
# need to know whether ZBOOT was on or off.
RUN cp arch/arm64/boot/vmlinuz.efi /Image \
 && ls -lh /Image
