# Minimum-viable cloud guest kernel, layered on top of `tinyconfig`.
# Goal: just enough to boot via EFISTUB in QEMU virt, mount a gzipped
# initramfs, run /init, power off cleanly.
#
# What's NOT here (and never will be) on purpose:
#   * any block device beyond virtio-blk
#   * any filesystem beyond tmpfs + initramfs
#   * any sound, graphics, input, USB, MTD, MMC, ATA, NVMe, hwmon,
#     thermal, power-supply, kexec, hibernation, BPF, KVM, security
#     framework, tracing, perf, KGDB, lockdep
#
# What IS here besides the irreducible boot path: a minimal IPv4 stack
# over virtio-net, so the guest can do DNS / outbound HTTP. IPv6, packet
# filtering, bridging, VLANs, tunnelling, fancy qdiscs etc. all stay off.
#
# Anything that breaks an actual cloud boot can be added here.

# ---- Architecture bits the arm64 build can't function without ----
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_SMP=y                  # virt machines can be multi-vCPU
CONFIG_ARCH_VIRT=y            # QEMU virt machine
CONFIG_PSCI=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_HAVE_KERNEL_GZIP=y
CONFIG_KERNEL_GZIP=y

# ---- EFI / EFISTUB boot path ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_GENERIC_STUB_INITRD_CMDLINE_LOADER=y
# Self-decompressing wrapper (vmlinuz.efi target). Slashes the on-disk
# kernel size by ~5× on aarch64.
CONFIG_EFI_ZBOOT=y

# ---- Console: QEMU virt machine uses PL011 at 0x9000000 ----
CONFIG_TTY=y
CONFIG_PRINTK=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ---- Initramfs ingestion ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y

# ---- VirtIO so future cloud workloads have a path to the host ----
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLOCK=y

# ---- Networking: minimal IPv4 + virtio-net so the guest can resolve
#      DNS and reach external HTTP endpoints. AF_UNIX is here too
#      because most userspace (libc resolver, busybox) needs it. ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y               # AF_PACKET — DHCP clients use raw sockets
CONFIG_UNIX=y                 # AF_UNIX — libc / busybox / nss
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# Let the kernel itself bring the link up + grab a DHCP lease, so /init
# can curl without dragging a userspace DHCP client into the initramfs.
# Pass `ip=dhcp` on the kernel command line to activate.
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# ---- Tiny stat / proc surface so userspace can be inspected ----
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ---- ACPI: OVMF arm64 firmware exposes hardware via ACPI tables (not
#      a DTB), so without this the kernel never discovers the PL011
#      UART address and goes silent after ExitBootServices. ----
CONFIG_ACPI=y

# ---- Optimize for size, not speed ----
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# ---- Single-CPU stub: nr_cpus=1 baked in ----
#
# Same reasoning as cloud-arm64.config (see its long comment): the
# cloud-boot stub kernel runs strictly serially (boot → fetch plan →
# kexec). arm64 mainline forces CONFIG_SMP=y (def_bool y, UP support
# was dropped), so we can't compile SMP out; we instead tell the
# kernel up front to only ever bring up CPU 0. That sidesteps the
# arm64 cpu_die / PSCI_CPU_OFF path entirely — which matters on HVF
# (Apple Silicon) where PSCI_CPU_OFF returns instead of halting the
# vCPU, blowing up cpu_die()'s final BUG at smp.c:385.
#
# Requires patches/arm64-cmdline-extend.patch applied at build time
# (mainline arm64 doesn't expose CMDLINE_EXTEND as a choice, only
# FROM_BOOTLOADER + FORCE). Drop the patch when it lands upstream.
#
# CMDLINE_EXTEND appends our fragment to whatever the EFI stub read
# from the UKI's .cmdline section, so cloudboot.* directives still
# flow through.
CONFIG_CMDLINE="nr_cpus=1"
CONFIG_CMDLINE_EXTEND=y
