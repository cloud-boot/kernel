# Cloud-minimal riscv64 kernel fragment. Overlaid on top of
# `make ARCH=riscv defconfig` (which already enables RISCV_SBI / EFI /
# virtio drivers / 8250 serial / devtmpfs / ACPI) and stripped of every
# SoC driver and peripheral irrelevant to a QEMU virt guest. Mirrors
# cloud-arm64.config in structure — same intent, same trim list, plus a
# few riscv-specific knobs.

# ---- Keep SOC_VIRT + drop the vendor SoC zoo ----
CONFIG_SOC_VIRT=y
# CONFIG_SOC_SIFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_SOC_CANAAN is not set
# CONFIG_SOC_MICROCHIP_POLARFIRE is not set
# CONFIG_SOC_RENESAS is not set

# ---- Audio / GPU / framebuffer: cloud is headless serial ----
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set

# ---- Input: no physical peripherals on a server VM ----
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set

# ---- USB / HID: replaced by virtio in cloud guests ----
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID is not set

# ---- Wireless / Bluetooth: no business in a VM ----
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set

# ---- Storage: virtio-blk only ----
# CONFIG_MD is not set
# CONFIG_BLK_DEV_DRBD is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_NVME_CORE is not set

# ---- Bus / peripheral controllers a virt machine never exposes ----
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PARPORT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_PCMCIA is not set

# ---- Sensors / thermal / power: VMs don't have batteries ----
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_RC_CORE is not set
# CONFIG_WATCHDOG is not set

# ---- Hibernation / cpu hotplug / kexec niceties ----
CONFIG_HIBERNATION=n
CONFIG_PM_AUTOSLEEP=n
CONFIG_PM_DEBUG=n
# Keep KEXEC + KEXEC_FILE on: cloud-boot-init chains a fetched kernel
# via kexec_file_load(2). KEXEC_SIG off because we don't ship signed
# kernel images for the test bench.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_SIG=n

# ---- Filesystems: keep ext4, vfat, tmpfs ----
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_AFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_BFS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_PSTORE is not set
CONFIG_EFI_PARTITION=y

# ---- Network: drop the vendor zoo (see also cloud-arm64.config) ----
CONFIG_ETHERNET=n
CONFIG_BRIDGE=n
CONFIG_VLAN_8021Q=n
CONFIG_NET_SCHED=n
CONFIG_NET_CLS=n
CONFIG_BPFILTER=n
CONFIG_BONDING=n
CONFIG_NET_TEAM=n
CONFIG_TIPC=n
CONFIG_ATM=n
CONFIG_DECNET=n
CONFIG_LLC2=n
CONFIG_RDS=n
CONFIG_SCTP=n
CONFIG_DCCP=n
CONFIG_L2TP=n
CONFIG_CAIF=n

# ---- Tracing / profiling: huge, off by default ----
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_KERNEL is not set

# ---- Crypto: keep the kernel-internal minimum ----
CONFIG_CRYPTO_HW=n

# ---- What we actually need ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
CONFIG_EFI_GENERIC_STUB_INITRD_CMDLINE_LOADER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# virtio-rng + hwrng: required to seed the CRNG fast enough for
# cloud-boot-init's DHCP client. Without it getrandom() blocks while
# the kernel waits for entropy from interrupt jitter.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_RNG=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_BINFMT_ELF=y
CONFIG_ACPI=y
CONFIG_PCI=y

# ---- Smaller, simpler scheduler / kernel ----
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_BPF_PRELOAD is not set
# CONFIG_AIO is not set
# CONFIG_FANOTIFY is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_SECURITY is not set
# CONFIG_HARDENED_USERCOPY is not set

# ---- EFI zboot wrapper: ship a self-decompressing PE32+ stub ----
# Drops the on-disk Image size by ~3× because the payload is gzipped
# inside the EFISTUB wrapper. Decompresses to RAM at boot.
CONFIG_EFI_ZBOOT=y

# ---- Single-CPU stub: disable SMP entirely ----
#
# Same reasoning as cloud-amd64.config: this is the cloud-boot *stub*
# kernel whose only job is to fetch a plan and kexec. It runs strictly
# serially — no parallelism to exploit. riscv64's mainline Kconfig
# exposes SMP as a regular bool (`bool "Symmetric Multi-Processing"`),
# unlike arm64 which forces SMP=y, so we get to disable it cleanly here.
#
# Benefits:
#   - No cpu_die / hotplug / IPI / SBI HSM (Hart State Management) code.
#   - Smaller kernel image, faster boot.
#   - No risk of running into an SBI / HSM "CPU_OFF returns" bug at
#     kexec time on any hypervisor that doesn't fully emulate hart
#     offlining (same class of issue as arm64+HVF — see arm64 sibling
#     config's long comment).
#
# NOTE: do NOT use this config for the TARGET kernel.
# CONFIG_SMP is not set
